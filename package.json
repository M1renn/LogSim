{
  "name": "logisim",
  "productName": "LogiSim",
  "version": "0.1.0",
  "description": "LogiSim — пошаговый обучающий симулятор работы логиста с ИИ-персонажами",
  "author": "Egor Kaunov",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/standalone.ts",
    "dev:web": "vite",
    "build": "vite build && node build.mjs",
    "start": "electron .",
    "app": "npm run build && electron .",
    "web": "node dist-server/server.cjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/simulate.ts",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "lv.logisim.app",
    "productName": "LogiSim",
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LogiSim"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
